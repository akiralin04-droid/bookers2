<div class="container px-5 px-sm-0">
  <div class="row">
    
    <!-- ★★★ 左側：部分テンプレート呼び出し ★★★ -->
    <!-- ※注意: ここでの user は @user (表示中のユーザー) を渡します -->
    <%= render 'books/list', user: @user, book: @book %>

    <!-- ★★★ 右側：Books一覧（そのユーザーの投稿のみ） ★★★ -->
    <div class="col-md-8 offset-md-1">
      <h2>Books</h2>
      <table class="table table-hover table-inverse">
        <thead>
          <tr>
            <th></th>
            <th>Title</th>
            <th>Opinion</th>
            <th colspan="3"></th>
          </tr>
        </thead>
        <tbody>
          <% @books.each do |book| %>
            <tr>
              <td>
                <!-- ユーザー画像（クリックでそのユーザーのページへ） -->
                <%= link_to user_path(book.user) do %>
                  <%= image_tag book.user.get_profile_image(80,80) %>
                <% end %>
              </td>
              <td>
                <!-- 本のタイトル（クリックで詳細へ） -->
                <%= link_to book.title, book_path(book.id) %>
              </td>
              <td><%= book.body %></td>

              <!-- ★★★ ↓↓↓ 星評価の表示（ここから） ↓↓↓ ★★★ -->
            <td>
              <div id="star_<%= book.id %>"></div>
              <script>
                $(document).ready(function() {
                  $('#star_<%= book.id %>').empty(); // 念のため空にする
                  $('#star_<%= book.id %>').raty({
                    size: 36,
                    readOnly: true,
                    score: <%= book.star || 0 %>,
                    // Font Awesome設定（画像パスは書きません）
                    starType: 'i',
                    starOn: 'fas fa-star text-warning',
                    starOff: 'far fa-star text-muted',
                    starHalf: 'fas fa-star-half-alt text-warning',
                  });
                });
              </script>
            </td>
            
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>

  </div>
</div>