<div class="container px-5 px-sm-0">
  <div class="row">
    
    <!-- ★★★ 左側：User info & New book ★★★ -->
    <div class="col-md-3">
      <h2>User info</h2>
      <%= image_tag @user.get_profile_image(100,100) %>
      <table class="table">
        <tbody>
          <tr>
            <th>name</th>
            <th><%= @user.name %></th>
          </tr>
          <tr>
            <th>introduction</th>
            <th><%= @user.introduction %></th>
          </tr>
        </tbody>
      </table>
      
      <div class="row">
        <%= link_to edit_user_path(@user), class: "btn btn-outline-secondary btn-block" do %>
          <i class="fas fa-user-cog"></i>
        <% end %>
      </div>

      <h2 class="mt-3">New book</h2>
      <!-- ここ重要：モデルは @new_book を使います -->
      <%= form_with model: @new_book, url: books_path do |f| %>
        <div class="form-group">
          <%= f.label :title %>
          <%= f.text_field :title, class: 'form-control' %>
        </div>
        <div class="form-group">
          <%= f.label :opinion %>
          <%= f.text_area :body, class: 'form-control' %>
        </div>
        <div class="form-group">
          <%= f.submit 'Create Book', class: 'btn btn-success' %>
        </div>
      <% end %>
    </div>

    <!-- ★★★ 右側：Book Detail ★★★ -->
    <div class="col-md-8 offset-md-1">
      <h2>Book detail</h2>
      <table class="table">
        <tbody>
          <tr>
            <td>
              <%= link_to user_path(@user) do %>
                <%= image_tag @user.get_profile_image(100,100) %><br>
                <%= @user.name %>
              <% end %>
            </td>
            <td><%= link_to @book.title, book_path(@book) %></td>
            <td><%= @book.body %></td>
            
            <td id="favorite_btn_<%= @book.id %>">
              <%= render 'favorites/btn', book: @book %>
            </td>

            <td id="comment_count">
              コメント数：<%= @book.book_comments.count %>
            </td>

            <!-- ログインしているユーザー本人の投稿なら、編集・削除ボタンを表示 -->
            <% if @book.user == current_user %>
              <td>
                <%= link_to "Edit", edit_book_path(@book), class: "btn btn-sm btn-success" %>
              </td>
              <td>
                <%= link_to "Destroy", book_path(@book), data: { turbo_method: :delete, turbo_confirm: "本当に消しますか？" }, class: "btn btn-sm btn-danger" %>
              </td>
            <% end %>
            
          </tr>
        </tbody>
      </table>

      <!-- コメント一覧 -->
      <div id="comment_index">
        <%= render "book_comments/index", book: @book %>
      </div>

      <!-- コメント投稿フォーム -->
      <div class="mt-4" id="comment_form"> <!-- ID "comment_form" を追加 -->
        <%= form_with model: [@book, BookComment.new] do |f| %>
          <div class="form-group">
            <%= f.text_area :comment, rows: '5', class: "form-control", placeholder: "コメントをここに" %>
          </div>
          <%= f.submit "送信", class: "mt-2" %>
        <% end %>
      </div>


    </div>
  </div>
</div>