<div class="container px-5 px-sm-0">
  
  <!-- エラーメッセージ（バリデーション用） -->
  <% if @book.errors.any? %>
    <div id="error_explanation">
      <h3><%= @book.errors.count %> errors prohibited this book from being saved:</h3>
      <ul>
        <% @book.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="row">
    <!-- ★★★ 左側：User info & New book ★★★ -->
    <!-- ★★★ 左側：部分テンプレート呼び出し ★★★ -->
    <%= render 'list', user: @user, book: @book %>

    <!-- ★★★ 右側：Books一覧 ★★★ -->
    <div class="col-md-8 offset-md-1">
      <h2>Books</h2>
      <p>
        <%= link_to '新しい順', books_path(latest: "true") %>
        | 
        <%= link_to '評価の高い順', books_path(rating: "true") %>
      </p>

      <table class="table table-hover table-inverse">
        <thead>
          <tr>
            <th></th>
            <th>Title</th>
            <th>Category</th> <!-- 追加 -->
            <th>Opinion</th>
            <th>Rate</th> 
            <th colspan="3"></th>
          </tr>
        </thead>

        <tbody>
          <% @books.each do |book| %>
            <tr>
              <td>
                <%= link_to user_path(book.user) do %>
                  <%= image_tag book.user.get_profile_image(80,80) %>
                <% end %>
              </td>

              <td>
                <%= link_to book.title, book_path(book.id) %>
              </td>

              <td>
                <!-- ★★★ 追加：カテゴリへのリンク ★★★ -->
                <% if book.category.present? %>
                  <%= link_to book.category, books_path(category: book.category) %>
                <% end %>
              </td>

              <!-- ★Opinion（感想/Body） -->
              <td><%= book.body %></td>

              <td id="favorite_btn_<%= book.id %>">
                <%= render 'favorites/btn', book: book %>
              </td>
              <td>
                コメント数：<%= book.book_comments.count %>
              </td>

              <!-- ★★★ 星評価の表示 ★★★ -->
              <td>
                <div id="star_<%= book.id %>"></div>
                <script>
                  $(document).ready(function() {
                    $('#star_<%= book.id %>').raty({
                      size: 36,
                      readOnly: true, // 読み取り専用（入力できない）
                      score: <%= book.star || 0 %>, // 保存された値をセット
                      // Font Awesome設定
                      starType: 'i',
                      starOn: 'fas fa-star text-warning',
                      starOff: 'far fa-star text-muted',
                      starHalf: 'fas fa-star-half-alt text-warning', // 半分の星（必要なら）

                    });
                  });
                </script>
                </td>

            </tr>
          <% end %>
        </tbody>

      </table>
    </div>
  </div>


</div>