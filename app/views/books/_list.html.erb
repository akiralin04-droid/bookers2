<div class="col-md-3">
  <h2>User info</h2>
  <%= image_tag user.get_profile_image(100,100) %>
  <table class="table">
    <tbody>
      <tr>
        <th>name</th>
        <th><%= user.name %></th>
      </tr>
      <tr>
        <th>introduction</th>
        <th><%= user.introduction %></th>
      </tr>
      <tr>
        <th>follows</th>
        <!-- フォロー一覧へのリンク -->
        <th><%= link_to user.followings.count, user_followings_path(user) %></th>
      </tr>
      <tr>
        <th>followers</th>
        <!-- フォロワー一覧へのリンク -->
        <th><%= link_to user.followers.count, user_followers_path(user) %></th>
      </tr>
    </tbody>
  </table>
  
  <div class="row">
    <%= link_to edit_user_path(user), class: "btn btn-outline-secondary btn-block" do %>
      <i class="fas fa-user-cog"></i>
    <% end %>
  </div>

  <div class="row">
  <!-- 既存の編集ボタン -->
  <%= link_to edit_user_path(user), class: "btn btn-outline-secondary btn-block" do %>
    <i class="fas fa-user-cog"></i>
  <% end %>
  
  <!-- ★追加：フォローボタン -->
  <div class="mt-2">
    <%= render 'relationships/btn', user: user %>
  </div>
  </div>

  <h2 class="mt-3">New book</h2>
  <%= form_with model: book, url: books_path do |f| %>
    <div class="form-group">
      <%= f.label :title %>
      <%= f.text_field :title, class: 'form-control' %>
    </div>

    <div class="form-group">
      <%= f.label :opinion %>
      <%= f.text_area :body, class: 'form-control' %>
    </div>

     <!-- ★★★ 評価（星）の入力欄 ★★★ -->
    <!-- 編集画面や、再描画時などに重複しないよう、book.idがない（新規）時だけ表示 -->
    <% if book.id.nil? %>
      <div class="form-group" id="star">
        <%= f.label :star %>
        <%= f.hidden_field :star, id: :review_star, class: 'form-control' %>
        <div id="post_raty"></div>
      </div>
      
      <!-- JavaScriptの記述 -->
      <script>
        // ページの読み込み完了後に実行
        $(document).ready(function() {
          // すでに表示されていたらリセット（重複防止）
          $('#post_raty').empty();
        
          $('#post_raty').raty({
            scoreName: 'book[star]', // データベースのstarカラムに値を送る設定
            // Font Awesomeを使うための設定（重要！）
            starType: 'i',
            starOn: 'fas fa-star text-warning', // 黄色の塗りつぶし星
            starOff: 'far fa-star text-muted',  // グレーの枠線星
            starHalf: 'fas fa-star-half-alt text-warning', // 半分の星（必要なら）
          });
        });
      </script>
    <% end %>
    
    <div class="form-group">
      <%= f.submit 'Create Book', class: 'btn btn-success' %>
    </div>

  <% end %>
</div>